{
  "name": "@dbcanvas/desktop",
  "version": "1.1.2",
  "description": "DBCanvas Desktop - Electron app with dashboard and MCP management",
  "type": "module",
  "main": "build/main.js",
  "scripts": {
    "build": "tsc && npx esbuild src/preload.ts --bundle --platform=node --format=cjs --outfile=build/preload.js --external:electron",
    "build:dashboard": "cd dashboard && npm run build",
    "build:full": "tsc && npx esbuild src/preload.ts --bundle --platform=node --format=cjs --outfile=build/preload.js --external:electron",
    "start": "npm run build:full && electron .",
    "dashboard": "node build/server.js",
    "clean": "rm -rf build",
    "pack": "electron-builder --dir",
    "dist": "npm run prep-mcp && electron-builder",
    "dist:mac": "npm run build:full && npm run prep-mcp && electron-builder --mac",
    "dist:win": "npm run build:full && npm run prep-mcp && electron-builder --win",
    "prep-mcp": "node scripts/prepare-mcp.js",
    "rebuild-native": "electron-builder install-app-deps",
    "deploy:local": "mkdir -p ../platform/public/downloads && cp release/DBCanvas-Setup.exe ../platform/public/downloads/ 2>/dev/null || true && cp release/*.dmg ../platform/public/downloads/ 2>/dev/null || true && cp release/*.AppImage ../platform/public/downloads/ 2>/dev/null || true"
  },

  "dependencies": {
    "@dbcanvas/core": "*",
    "cors": "^2.8.6",
    "electron-updater": "^6.8.3",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.24",
    "electron": "34.1.1",
    "electron-builder": "^26.8.1",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.dbcanvas.desktop",
    "productName": "DBCanvas",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**/*",
      "dashboard/dist/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/@dbcanvas/core/src",
      "!**/*.ts",
      "!**/*.map"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "publish": {
      "provider": "github",
      "owner": "xaman1990",
      "repo": "dbcanvas"
    },
    "extraResources": [
      {
        "from": "mcp-release",
        "to": "mcp-server",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "assets/icon.icns",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "artifactName": "DBCanvas-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "DBCanvas-Setup.${ext}",
      "signAndEditExecutable": false
    },
    "forceCodeSigning": false,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "assets/icon.png",
      "artifactName": "DBCanvas.${ext}"
    }
  }
}

{
  "name": "@dbcanvas/desktop",
  "version": "1.0.0",
  "description": "DBCanvas Desktop - Electron app with dashboard and MCP management",
  "type": "module",
  "main": "build/main.js",
  "scripts": {
    "build": "tsc",
    "build:dashboard": "cd dashboard && npm run build",
    "build:full": "tsc && cd dashboard && npm run build",
    "start": "electron .",
    "dashboard": "node build/server.js",
    "clean": "rm -rf build",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "rebuild-native": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@dbcanvas/core": "*",
    "cors": "^2.8.6",
    "electron-updater": "^6.8.3",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.24",
    "electron": "41.1.1",
    "electron-builder": "^26.8.1",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.dbcanvas.desktop",
    "productName": "DBCanvas",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**/*",
      "dashboard/dist/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/@dbcanvas/core/src",
      "!**/*.ts",
      "!**/*.map"
    ],
    "asarUnpack": [
      "**/node_modules/sqlite3/**",
      "**/*.node"
    ],
    "publish": {
      "provider": "github",
      "owner": "xaman1990",
      "repo": "dbcanvas"
    },
    "extraResources": [
      {
        "from": "../../packages/mcp-server/build/bundle.mjs",
        "to": "mcp-server/index.mjs"
      },
      {
        "from": "../../node_modules/sqlite3",
        "to": "mcp-server/node_modules/sqlite3",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../node_modules/tedious",
        "to": "mcp-server/node_modules/tedious",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "artifactName": "DBCanvas.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "DBCanvas-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "assets/icon.png",
      "artifactName": "DBCanvas.${ext}"
    }
  }
}
